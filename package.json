{
  "name": "unified-service-scheduler",
  "version": "1.0.0",
  "description": "Backend implementation for Keyloop Scenario A: Unified Service Scheduler",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write \"{src,test,scripts,database,docs}/**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{src,test,scripts,database,docs}/**/*.{ts,js,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "jest --config test/jest-unit.json --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:concurrency": "jest --config test/jest-concurrency.json --runInBand",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm test:concurrency",
    "test:coverage": "jest --config test/jest-unit.json --coverage --runInBand",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/shared/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/database/data-source.ts",
    "seed": "ts-node src/shared/database/seed.ts",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@nestjs/cli": "11",
    "@nestjs/testing": "11",
    "@types/express": "5",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.7.1",
    "@types/node": "22",
    "@types/source-map-support": "0.5.10",
    "@types/supertest": "6.0.3",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.104.1",
      "ajv@>=8.0.0": "8.18.0",
      "picomatch@>=4.0.0": "4.0.4"
    }
  }
}
